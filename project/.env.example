# ============================================================
# 复制这个文件为 .env，再把下面的值换成你自己的高德 key
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# ★ .env 已被 .gitignore 忽略，不会被提交。不要把它改名提交。
# ★ 申请步骤见 README「三、申请高德 Key」
# ============================================================

# 【1】Web 服务 key —— 服务平台必须选「Web服务」
#     用途：地理编码、坐标转换、路径规划
#     本项目用在哪：scripts/build-trail-profile.mjs 的坐标系校验、geocode
#     不填的后果：仍能跑通，但会跳过 WGS84→GCJ-02 自动判定，按 WGS-84 直接处理
AMAP_SERVER_KEY=

# 【2】Web 端（JS API）key —— 服务平台必须选「Web端(JS API)」
#     用途：浏览器里加载高德地图（本项目只有 3D 查看器会用到）
#     不填的后果：不影响轨迹动画与调参台，只在生成 3D 查看器时报错
AMAP_WEB_JS_KEY=

# 【3】上面 JS API key 对应的安全密钥（jscode）
#     2021-12-02 之后申请的 key 必须成对使用
#     不填的后果：同【2】
AMAP_WEB_SECURITY_CODE=
